# BenDavid OS settings. Copy this file to ".env" in the same folder and fill in
# only what you need. .env is git-ignored and read by the local server only:
# values are never sent to the browser. Never paste keys into chat.

# PORT=4321
# BENDAVID_TIMEZONE=America/New_York

# --- AI service (lightweight reasoning) ---------------------------------
# Your Anthropic API key, from https://console.anthropic.com
# ANTHROPIC_API_KEY=
# The model to use. Any current model ID works; you choose cost vs. quality.
# Example: claude-opus-5-5 (most capable) or claude-haiku-5-5 (cheapest).
# The Connections page self-test checks it is available to your key.
# BENDAVID_LIGHT_MODEL=

# --- Claude Code (workflow execution) -------------------------------------
# Only needed if Claude Code is installed somewhere BenDavid OS can't find.
# Point to claude.exe (native install) or the npm package's cli.js.
# CLAUDE_CODE_PATH=C:\Users\YOU\.local\bin\claude.exe
# Optional model for Claude Code runs (otherwise Claude Code's default):
# BENDAVID_CLAUDE_CODE_MODEL=
