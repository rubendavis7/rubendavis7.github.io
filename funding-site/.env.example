# Copy this file to .env.local and fill in what you need.
# Every value is optional. With nothing set, the site still runs and saves
# leads to ./data. Never commit real values.

# --- Admin page (/admin) ------------------------------------------------------
# Leave empty to keep /admin turned off. Use a long, random password.
ADMIN_PASSWORD=

# --- Alerts -------------------------------------------------------------------
# POSTs JSON for every new application and every feedback rating.
# Works as-is with a Slack incoming webhook, Zapier, Make or a CRM webhook.
WEBHOOK_URL=

# Email alerts through Resend (https://resend.com). Both values are needed.
RESEND_API_KEY=
# Where alerts go. Separate several addresses with commas.
NOTIFY_EMAIL=
# Optional sender, on a domain you verified in Resend.
# Example: Delta Capital Website <leads@yourdomain.com>
NOTIFY_FROM=

# --- Storage ------------------------------------------------------------------
# Folder for the local JSON-lines files. Default: ./data
DATA_DIR=

# Permanent storage for hosts with a temporary disk (Vercel).
# Create an Upstash Redis / Vercel KV store and paste its REST URL and token.
KV_REST_API_URL=
KV_REST_API_TOKEN=
